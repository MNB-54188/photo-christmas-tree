{
  "name": "photo-christmas-tree",
  "version": "1.0.0",
  "private": true,
  "description": "用照片拼成的 3D 圣诞树相册，支持摄像头手势控制，部署在 Cloudflare Pages + D1 + KV",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public",
    "test:gesture": "node test/gesture_unit.mjs",

    "db:create": "wrangler d1 create photo-tree-db",
    "db:init": "wrangler d1 execute photo-tree-db --file=./migrations/0001_init.sql",
    "db:init:remote": "wrangler d1 execute photo-tree-db --remote --file=./migrations/0001_init.sql",
    "db:list": "wrangler d1 execute photo-tree-db --remote --command=\"SELECT COUNT(*) AS total FROM photos\"",

    "kv:create": "wrangler kv namespace create PHOTOS_KV",
    "kv:list": "wrangler kv key list --binding=PHOTOS_KV"
  },
  "devDependencies": {
    "wrangler": "^3.99.0"
  }
}
